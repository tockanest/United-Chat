{
	"productName": "united-chat",
	"version": "0.1.0",
	"identifier": "nixyan.united-chat",
	"build": {
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build",
		"devUrl": "http://localhost:3000",
		"frontendDist": "../out"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"resources": [
			"./assets/**/*"
		],
		"targets": "all",
		"icon": [
			"icons/icon.ico",
			"icons/icon.png"
		]
	},
	"plugins": {
		"deep-link": {
			"mobile": [
				{
					"host": "uc.tockanest.com",
					"pathPrefix": [
						"/"
					]
				}
			],
			"desktop": {
				"schemes": [
					"unitedchat"
				]
			}
		}
	}
}